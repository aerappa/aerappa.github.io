

@article{HMRV2026,
    author = {Harnist, André and Mitra, Koondanibha and Rappaport, Ari E. and Vohralík, Martin},
    title = {Robust augmented energy a posteriori estimates for Lipschitz and strongly monotone elliptic problems},
    journal = {IMA Journal of Numerical Analysis},
    pages = {drag036},
    year = {2026},
    month = {07},
    preprint = {https://hal.science/hal-04033438},
    abstract = {In this paper, we design a posteriori estimates for finite-element approximations of nonlinear elliptic problems satisfying strong-monotonicity and Lipschitz-continuity properties. These estimates include, and build on, any iterative linearization method that satisfies a few clearly identified assumptions; this, in particular, encompasses the Picard, Newton and Zarantonello linearizations. The estimates give a guaranteed upper bound on an augmented energy difference (reliability with constant one), as well as a lower bound (efficiency up to a generic constant). We prove that for the Zarantonello linearization, this generic constant depends only on the space dimension, the mesh shape regularity and possibly the approximation polynomial degree in four or more space dimensions, making the estimates robust with respect to the strength of the nonlinearity. For the other linearizations, the additional overestimation factor only depends on the local variation of the linearization operators and is fully computable. We also derive similar estimates for the usual energy difference. These only depend locally on the nonlinearity and improve the established bounds. Numerical experiments illustrate and validate the theoretical results, for both smooth and singular solutions.},
    issn = {0272-4979},
    doi = {10.1093/imanum/drag036},
    url = {https://doi.org/10.1093/imanum/drag036},
    eprint = {https://academic.oup.com/imajna/advance-article-pdf/doi/10.1093/imanum/drag036/69579616/drag036.pdf},
}

@article{RCM2026,
author = {Rappaport, A. E. and Chaumont-Frelet, T. and Modave, A.},
title = {A Hybridizable Discontinuous Galerkin Method with Transmission Variables for Time-Harmonic Electromagnetic Problems},
journal = {SIAM Journal on Scientific Computing},
volume = {48},
number = {4},
pages = {B629-B650},
year = {2026},
doi = {10.1137/25M1756818},
preprint = {https://hal.science/hal-05016261},

URL = { 
        https://doi.org/10.1137/25M1756818 
},
eprint = { 
        https://doi.org/10.1137/25M1756818
}
,
    abstract = { Abstract. The CHDG method is a hybridizable discontinuous Galerkin (HDG) finite element method suitable for the iterative solution of time-harmonic wave propagation problems. Hybrid unknowns corresponding to transmission variables are introduced at the element interfaces, and the physical unknowns inside the elements are eliminated, resulting in a hybridized system with favorable properties for fast iterative solution. In this paper, we extend the CHDG method, initially studied for the Helmholtz equation, to the time-harmonic Maxwell equations. We prove that the local problems stemming from hybridization are well-posed and that the fixed-point iteration naturally associated to the hybridized system is contractive. We propose a 3D implementation with a discrete scheme based on nodal basis functions. The resulting solver and different iterative strategies are studied with several numerical examples using a high-performance parallel C++ code. }
}

